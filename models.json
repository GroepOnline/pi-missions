{
  "$schema": "https://raw.githubusercontent.com/GroepChef/pi-missions/main/models.schema.json",
  "version": 1,
  "presets": {
    "fast": {
      "provider": "azure-deepseek",
      "model": "DeepSeek-V4-Flash",
      "description": "Fast and cheap — ideal for scouts, reviewers, and simple lookups"
    },
    "balanced": {
      "provider": "azure-fireworks",
      "model": "fw-kimi-k2-5",
      "description": "Balanced speed and reasoning — good default for workers and planners"
    },
    "powerful": {
      "provider": "azure-fireworks",
      "model": "fw-glm-5-1",
      "description": "Strongest reasoning — use for complex planning, debugging, and critical reviews"
    }
  },
  "agents": {
    "mission-scout": {
      "preset": "balanced",
      "fallbackModels": [
        "fw-kimi-k2-5",
        "fw-glm-5-1"
      ]
    },
    "mission-planner": {
      "preset": "balanced",
      "fallbackModels": [
        "fw-glm-5-1",
        "DeepSeek-V4-Flash"
      ]
    },
    "mission-worker": {
      "preset": "balanced",
      "fallbackModels": [
        "fw-glm-5-1",
        "DeepSeek-V4-Flash"
      ]
    },
    "mission-reviewer": {
      "preset": "balanced",
      "fallbackModels": [
        "fw-kimi-k2-5",
        "fw-glm-5-1"
      ]
    }
  },
  "orchestrator": {
    "preset": "balanced",
    "fallbackModels": [
      "fw-glm-5-1",
      "DeepSeek-V4-Flash"
    ]
  }
}
