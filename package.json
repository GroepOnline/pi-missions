{
  "name": "@devctx/pi-missions",
  "version": "0.1.2",
  "description": "Durable mission orchestration for the Pi coding agent",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "missions",
    "coding-agent",
    "orchestration",
    "task-management",
    "sqlite",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OnlineChefGroep/pi-missions.git"
  },
  "homepage": "https://github.com/OnlineChefGroep/pi-missions#readme",
  "bugs": {
    "url": "https://github.com/OnlineChefGroep/pi-missions/issues"
  },
  "author": "OnlineChefGroep",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-build-assets.mjs",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench",
    "prepublishOnly": "npm run build",
    "db:init": "node dist/cli/index.js doctor",
    "test:coverage": "vitest run --coverage",
    "smoke:ci": "node scripts/ci-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.77.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "typebox": "^1.1.38"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.31.28",
    "proper-lockfile": "^4.1.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.19.18",
    "@types/proper-lockfile": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  },
  "bin": {
    "pi-missions": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
