# Environment Variables for pi-missions
# Copy this file to .env and fill in the values

# Custom database path (default: ~/.pi/missions/database)
# PI_MISSIONS_DB_PATH=/path/to/database

# Custom missions storage root (default: ~/.pi/missions)
# PI_MISSIONS_ROOT=/path/to/missions

# Override worker model (default: inherited from session)
# PI_WORKER_MODEL=claude-sonnet-4-20250514

# Project directory (set automatically at runtime)
# PI_MISSIONS_PROJECT_DIR=/path/to/project

# Extension path (set automatically at runtime)
# PI_MISSIONS_EXTENSION_PATH=/path/to/extension

# Agent detection (set automatically)
# CODING_AGENT=pi
